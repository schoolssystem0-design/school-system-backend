# Backend environment (Railway variables). Copy values into Railway; never commit real secrets.
SPRING_PROFILES_ACTIVE=staging

# Database (Railway reference variables from the Postgres service)
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGDATABASE=${{Postgres.PGDATABASE}}
# Owner role used only by Flyway migrations
DB_MIGRATION_USER=${{Postgres.PGUSER}}
DB_MIGRATION_PASSWORD=${{Postgres.PGPASSWORD}}
# Restricted runtime role (created automatically after migration; RLS applies to it)
DB_APP_USER=sms_app_login
DB_APP_PASSWORD=<generate a long random password>

# Browser access
APP_CORS_ALLOWED_ORIGINS=https://staging-app.<platform>.com
APP_COOKIE_DOMAIN=.<platform>.com
APP_SESSION_IDLE_MINUTES=30
